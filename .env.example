# Environment variables for WriteupHub

# Database (PostgreSQL - Supabase / Local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/writeuphub?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/writeuphub?schema=public"

# Auth.js / NextAuth v5
AUTH_TRUST_HOST="true"
AUTH_SECRET="writeuphub-super-secret-development-key-change-in-production-min32chars"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (GCP Console Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (GitHub Developer Settings)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Telegram Login Widget (@BotFather)
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_ID=""

# Storage: Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="writeup-assets"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
